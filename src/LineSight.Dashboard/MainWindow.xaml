<Window x:Class="LineSight.Dashboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:LineSight.Dashboard.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="LineSight - Module Line MES"
        Width="1280" Height="800" MinWidth="1000" MinHeight="600"
        Background="{StaticResource PageBackground}"
        FontFamily="Segoe UI" FontSize="13">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- header -->
            <RowDefinition Height="Auto" />   <!-- station cards -->
            <RowDefinition Height="*" />      <!-- genealogy -->
        </Grid.RowDefinitions>

        <!-- ===== Header ===== -->
        <DockPanel Grid.Row="0" Margin="6,0,6,10" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="LineSight" FontSize="26" FontWeight="Bold" Foreground="{StaticResource Accent}" />
                <TextBlock Text="{Binding OeeWindowText}" Style="{StaticResource Caption}" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="10" Height="10" Margin="0,0,6,0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="#D64545" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                    <Setter Property="Fill" Value="#2E9E5B" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Button Content="Refresh now" Command="{Binding RefreshCommand}" />
            </StackPanel>
        </DockPanel>

        <!-- ===== Station cards (one per station, in line order) ===== -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Stations}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:StationCardViewModel}">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" />

                            <!-- State pill: colour comes from the converter -->
                            <Border Margin="0,8,0,0" Padding="10,3" CornerRadius="10" HorizontalAlignment="Left"
                                    Background="{Binding State, Converter={StaticResource StateToBrush}}">
                                <TextBlock Text="{Binding StateText}" Foreground="White" FontWeight="SemiBold" />
                            </Border>

                            <TextBlock Text="{Binding DowntimeReason}" Foreground="#D64545" FontWeight="SemiBold" Margin="0,6,0,0"
                                       Visibility="{Binding DowntimeReason, Converter={StaticResource EmptyToCollapsed}}" />

                            <TextBlock Text="OEE" Style="{StaticResource Caption}" Margin="0,14,0,0" />
                            <TextBlock Text="{Binding Oee, StringFormat={}{0:P1}}" FontSize="34" FontWeight="Bold" />

                            <!-- A / P / Q breakdown -->
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="52" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="22" />
                                    <RowDefinition Height="22" />
                                    <RowDefinition Height="22" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Availability" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                <ProgressBar Grid.Row="0" Grid.Column="1" Value="{Binding Availability, Mode=OneWay}" Style="{StaticResource FactorBar}" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding Availability, StringFormat={}{0:P0}}" HorizontalAlignment="Right" VerticalAlignment="Center" />

                                <TextBlock Grid.Row="1" Text="Performance" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                <ProgressBar Grid.Row="1" Grid.Column="1" Value="{Binding Performance, Mode=OneWay}" Style="{StaticResource FactorBar}" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Performance, StringFormat={}{0:P0}}" HorizontalAlignment="Right" VerticalAlignment="Center" />

                                <TextBlock Grid.Row="2" Text="Quality" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                <ProgressBar Grid.Row="2" Grid.Column="1" Value="{Binding Quality, Mode=OneWay}" Style="{StaticResource FactorBar}" />
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Quality, StringFormat={}{0:P0}}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>

                            <TextBlock Margin="0,8,0,0" Style="{StaticResource Caption}">
                                <Run Text="Good" /> <Run Text="{Binding GoodCount, Mode=OneWay}" FontWeight="SemiBold" />
                                <Run Text="  Scrap" /> <Run Text="{Binding ScrapCount, Mode=OneWay}" FontWeight="SemiBold" />
                            </TextBlock>

                            <TextBlock Text="{Binding TopDowntime}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Visibility="{Binding TopDowntime, Converter={StaticResource EmptyToCollapsed}}" />

                            <TextBlock Text="{Binding Warning}" Foreground="#B45309" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Visibility="{Binding Warning, Converter={StaticResource EmptyToCollapsed}}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ===== Module genealogy search ===== -->
        <Border Grid.Row="2" Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Module genealogy" FontSize="17" FontWeight="SemiBold" />

                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,10,0,6">
                    <TextBox Width="260" Padding="6,4" VerticalContentAlignment="Center"
                             Text="{Binding SearchSerial, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Serial number, e.g. FS-20261022-00001" />
                    <!-- IsDefault: pressing Enter in the window runs the search -->
                    <Button Content="Search" Margin="8,0,0,0" IsDefault="True" Command="{Binding SearchCommand}" />
                    <TextBlock Text="{Binding SearchMessage}" Foreground="#D64545" VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>

                <TextBlock DockPanel.Dock="Top" Text="{Binding ModuleSummary}" FontWeight="SemiBold" Margin="0,0,0,6"
                           Visibility="{Binding ModuleSummary, Converter={StaticResource EmptyToCollapsed}}" />

                <DataGrid ItemsSource="{Binding GenealogySteps}" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserAddRows="False"
                          BorderThickness="0" Background="Transparent" RowBackground="White">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Sequence}" Width="40" />
                        <DataGridTextColumn Header="Station" Binding="{Binding Station}" Width="200" />
                        <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="100" />
                        <DataGridTextColumn Header="Time (local)" Binding="{Binding LocalTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss.fff}}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</Window>
